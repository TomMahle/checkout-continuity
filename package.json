{
  "name": "checkout-continuity",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@continuity/web",
    "dev:mobile": "pnpm --filter @continuity/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test:run",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run typecheck lint test:run && pnpm format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
